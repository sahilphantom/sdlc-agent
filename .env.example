# ── LLM ──────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
SDLC_CODE_MODEL=qwen2.5-coder:3b
SDLC_REASON_MODEL=llama3.2:3b
SDLC_EMBED_MODEL=nomic-embed-text

# ── LangSmith ────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=sdlc-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
TRACING_BACKEND=langsmith

# ── Databases ────────────────────────────────────────────
DATABASE_URL=postgresql://sdlc:sdlc_pass@localhost:5432/sdlc_agent
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# ── GitHub ───────────────────────────────────────────────
GITHUB_TOKEN=your_github_pat_here
GITHUB_USERNAME=your_github_username

# ── Pipeline ─────────────────────────────────────────────
SDLC_MAX_RETRIES=3
SDLC_CONFIDENCE_THRESHOLD=0.75

# ── FastAPI ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_this

# ── General ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO